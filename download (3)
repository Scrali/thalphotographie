<?php
$page_title = 'Tarification — THAL Studio';
require __DIR__ . '/includes/header.php';
require_once __DIR__ . '/includes/pricing.php';

$file = __DIR__ . '/data/settings/estimation.json';
$current = thal_pricing_settings(__DIR__);
$message = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    foreach (thal_pricing_defaults() as $key => $default) {
        if (isset($_POST[$key])) {
            $current[$key] = is_numeric($default) ? (float)$_POST[$key] : trim((string)$_POST[$key]);
        }
    }
    if (!is_dir(dirname($file))) mkdir(dirname($file), 0755, true);
    file_put_contents($file, json_encode($current, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE), LOCK_EX);
    $message = 'Tarification enregistrée.';
}

function field_value(array $data, string $key): string {
    return htmlspecialchars((string)$data[$key], ENT_QUOTES, 'UTF-8');
}
